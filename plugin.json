{
  "id": "com.paca.time-logging",
  "displayName": "Time Logging",
  "description": "Lets project members manually log time spent on tasks (date, duration, note) and view per-member totals for a project.",
  "version": "0.2.1",
  "minCoreVersion": "v0.13.3",
  "permissions": ["db.read", "db.write", "events.subscribe"],
  "customPermissions": [
    {
      "key": "time_logging.manage_all",
      "label": "Manage all time logs",
      "description": "Edit or delete any project member's time log entries, not just their own.",
      "scope": "project"
    },
    {
      "key": "time_logging.view_all",
      "label": "View all time logs",
      "description": "View the project-wide time tracking page listing every member's logged time, not just their own. Does not affect per-task time log visibility, which any project member can already see via tasks.read.",
      "scope": "project"
    },
    {
      "key": "time_logging.view_all",
      "label": "View all time logs",
      "description": "View logged time summaries and entries across every project, not just the ones they're a member of.",
      "scope": "global"
    },
    {
      "key": "time_logging.manage_all",
      "label": "Manage all time logs",
      "description": "Edit or delete any project member's time log entries, across every project.",
      "scope": "global"
    }
  ],
  "backend": {
    "eventSubscriptions": ["task.deleted"],
    "routes": [
      {
        "method": "GET",
        "path": "/projects/:projectId/tasks/:taskId/time-logs",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["tasks.read"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/tasks/:taskId/time-logs",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["tasks.write"]
          }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/tasks/:taskId/time-logs/:logId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["tasks.write"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/tasks/:taskId/time-logs/:logId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["tasks.write"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/time-logs/me",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.read"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/time-logs",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["time_logging.view_all"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/time-logs/summary",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["time_logging.view_all"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/time-logs/summary-all",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["time_logging.view_all"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/time-logs/all",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["time_logging.view_all"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/time-logs/users-all",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["time_logging.view_all"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/time-logs/viewer-all",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["time_logging.view_all"]
          }
        ]
      },
      {
        "method": "PATCH",
        "path": "/time-logs/all/:logId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["time_logging.manage_all"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/time-logs/all/:logId",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "global",
            "permissions": ["time_logging.manage_all"]
          }
        ]
      }
    ]
  },
  "frontend": {
    "remoteEntryUrl": "/plugins/com.paca.time-logging/assets/remoteEntry.js",
    "extensionPoints": [
      {
        "point": "task.detail.section",
        "component": "TimeLogsSection",
        "order": 20
      },
      {
        "point": "project.page",
        "component": "ProjectTimeTrackingPage",
        "order": 20
      },
      {
        "point": "admin.page",
        "component": "AdminTimeTrackingPage",
        "order": 20
      }
    ],
    "navItems": [
      {
        "scope": "project",
        "slug": "time-tracking",
        "label": "Time Tracking",
        "icon": "Clock",
        "component": "ProjectTimeTrackingPage",
        "order": 20,
        "requiredPermission": "time_logging.view_all"
      },
      {
        "scope": "admin",
        "slug": "time-tracking",
        "label": "Time Tracking",
        "icon": "Clock",
        "component": "AdminTimeTrackingPage",
        "order": 20,
        "requiredPermission": "time_logging.view_all"
      }
    ]
  },
  "automation": {
    "triggers": [
      {
        "type": "time_logging.entry_created",
        "label": "Time Logging: Entry Created",
        "eventTopic": "time_logging.entry_created"
      }
    ],
    "conditions": [
      {
        "type": "time_logging.total_minutes_exceeds",
        "label": "Time Logging: Total Minutes Exceeds",
        "configSchema": {
          "type": "object",
          "required": ["threshold_minutes"],
          "properties": {
            "threshold_minutes": { "type": "integer", "title": "Threshold (minutes)", "minimum": 1 },
            "member_id": { "type": "string", "title": "Member (optional — omit to sum every member)", "format": "member" }
          }
        }
      }
    ],
    "actions": [
      {
        "type": "time_logging.log_time",
        "label": "Time Logging: Log Time",
        "configSchema": {
          "type": "object",
          "required": ["member_id", "spent_date", "minutes_spent"],
          "properties": {
            "member_id": { "type": "string", "title": "Member", "format": "member" },
            "spent_date": { "type": "string", "title": "Date", "format": "date" },
            "minutes_spent": { "type": "integer", "title": "Minutes Spent", "minimum": 1 },
            "note": { "type": "string", "title": "Note", "format": "textarea" }
          }
        }
      }
    ]
  },
  "mcp": {
    "remoteEntryUrl": "/plugins-mcp/com.paca.time-logging/mcp.js"
  }
}
